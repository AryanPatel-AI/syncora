# Syncora Client Environment Configuration (Vite + React)
#
# IMPORTANT:
# Vite embeds environment variables into the static JavaScript bundle at BUILD time.
# On Vercel, define these variables in "Project Settings" -> "Environment Variables"
# BEFORE triggering your production build or deployment.
#
# Local Development:
# When running the Vite dev server locally, defaults connect to port 4000.
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
VITE_SERVER_URL=http://localhost:4000

# Production Deployment (Render backend example):
# Set this to your deployed Render Web Service URL (do not add a trailing slash):
# VITE_API_URL=https://syncora-backend.onrender.com
# VITE_SOCKET_URL=https://syncora-backend.onrender.com
# VITE_SERVER_URL=https://syncora-backend.onrender.com
