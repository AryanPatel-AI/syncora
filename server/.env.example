# Syncora Server Environment Configuration (Render Web Service)
# Copy this file to .env for local overrides, or set these in the Render Dashboard.

# Port for HTTP and WebSocket server. In production on Render, $PORT is automatically injected.
PORT=4000

# Environment mode: 'development' or 'production'
# In production, strict CORS checking is enforced against FRONTEND_URL.
NODE_ENV=development

# Allowed frontend origin(s) for Express and Socket.IO CORS.
# Local development default: http://localhost:5173
# In production, set to your Vercel deployment URL (e.g., https://syncora.vercel.app).
# Multiple comma-separated origins are supported (e.g., https://syncora.vercel.app,https://syncora-aryan.vercel.app)
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# YouTube Data API v3 Key (Server-side only, kept private)
# Enables real-time YouTube live stream and video search, categories, and metrics.
# If unset, Syncora seamlessly falls back to its curated high-definition catalog.
YOUTUBE_API_KEY=your_youtube_api_key_here

# User Session / Auth Secret
# Used for cryptographic HMAC-SHA256 signing of user authentication tokens.
SESSION_SECRET=your_random_session_secret_here

# Persistent SQLite Database Path (Optional, defaults to ./watchparty.db)
DATABASE_PATH=./watchparty.db

# Managed Creator Live Broadcasting (Optional Module: Mux Video / Amazon IVS)
# Required only if creators broadcast direct RTMP streams from OBS rather than YouTube embeds.
MUX_TOKEN_ID=your_mux_token_id_here
MUX_TOKEN_SECRET=your_mux_token_secret_here
MUX_WEBHOOK_SECRET=your_mux_webhook_secret_here
